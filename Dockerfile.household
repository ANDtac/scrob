# Deliberate patch release on the verified upstream runtime; PostgreSQL stays17.11.
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM bellamy/scrob@sha256:eba40725a340ee4513415462d7cc8b4a95bd0df7d4b38a6ca5c8e355ed1c60d6
ARG SOURCE_REVISION=uncommitted
ENV APP_VERSION=2.37.0-household.1
LABEL org.opencontainers.image.source="https://github.com/ANDtac/scrob" \
      org.opencontainers.image.version="2.37.0-household.1" \
      org.opencontainers.image.revision=$SOURCE_REVISION
COPY backend/ /app/backend/
COPY --from=frontend /build/frontend/dist/ /app/frontend/dist/
